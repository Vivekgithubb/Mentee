<mxfile host="app.diagrams.net" modified="2026-10-28T12:00:00.000Z" agent="Mozilla/5.0" version="24.0.0" type="device">
  <diagram id="database-schema" name="Database Schema (ERD)">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" background="#F8FAFC" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Banner -->
        <mxCell id="title-banner" value="MEntee: Institutional Mentor–Mentee Management System&#xa;Comprehensive Database Schema Diagram (MongoDB / Mongoose Entity-Relationship Diagram)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1620" height="60" as="geometry" />
        </mxCell>

        <!-- ==================== ENTITY 1: USER ==================== -->
        <mxCell id="ent-user" value="User (users)&#xa;«Central Authentication &amp; Identity»" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#3B82F6;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="120" width="280" height="260" as="geometry" />
        </mxCell>
        <mxCell id="u-f1" value="+ _id: ObjectId [PK]&#xa;+ name: String&#xa;+ email: String [UNIQUE]&#xa;+ password: String [BCRYPT]&#xa;+ role: Enum [ADMIN, HOD, MENTOR, MENTEE]&#xa;+ department: String&#xa;+ designation: String&#xa;+ avatar: String (URL)&#xa;+ status: Enum [ACTIVE, INACTIVE]&#xa;+ createdAt: Date&#xa;+ updatedAt: Date" style="text;strokeColor=none;fillColor=#EFF6FF;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;fontColor=#1E293B;" vertex="1" parent="ent-user">
          <mxGeometry y="30" width="280" height="230" as="geometry" />
        </mxCell>

        <!-- ==================== ENTITY 2: STUDENT PROFILE ==================== -->
        <mxCell id="ent-profile" value="StudentProfile (studentprofiles)&#xa;«Mentee 360° Profile &amp; Allocation»" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#059669;strokeColor=#047857;fontColor=#FFFFFF;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="350" height="420" as="geometry" />
        </mxCell>
        <mxCell id="sp-f1" value="+ _id: ObjectId [PK]&#xa;+ user: ObjectId [FK -> User._id, UNIQUE]&#xa;+ studentId: String [USN]&#xa;+ registerNo: String&#xa;+ phone: String | dob: String | gender: String&#xa;+ bloodGroup: String | address: String&#xa;+ emergencyContact: { name, relation, phone }&#xa;+ department: String | batch: String&#xa;+ semester: Number (1-12) | section: String&#xa;+ cgpa: Number (0.00 - 10.00)&#xa;+ backlogs: Number&#xa;+ mentor: ObjectId [FK -> User._id] (Active Mentor)&#xa;+ mentorAssignedAt: Date&#xa;+ mentorAssignedBy: ObjectId [FK -> User._id]&#xa;+ assignmentHistory: [{ previousMentor, newMentor,&#xa;   assignedBy, reason, date }]&#xa;+ attendancePercentage: Number&#xa;+ status: Enum [EXCELLENT, ON_TRACK, AT_RISK]&#xa;+ riskReason: String&#xa;+ career: { goal, domain, targetCompanies[], resumeUrl }&#xa;+ skills: { programming[], frameworks[], cloud[], db[] }&#xa;+ profileCompletion: Number (0-100%)" style="text;strokeColor=none;fillColor=#ECFDF5;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;fontColor=#1E293B;" vertex="1" parent="ent-profile">
          <mxGeometry y="30" width="350" height="390" as="geometry" />
        </mxCell>

        <!-- ==================== ENTITY 3: ACADEMIC RECORD ==================== -->
        <mxCell id="ent-academic" value="AcademicRecord (academicrecords)&#xa;«Semester Marks, SGPA &amp; Audit Trail»" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#D97706;strokeColor=#B45309;fontColor=#FFFFFF;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="350" height="300" as="geometry" />
        </mxCell>
        <mxCell id="ar-f1" value="+ _id: ObjectId [PK]&#xa;+ student: ObjectId [FK -> User._id]&#xa;+ semester: Number (1-12)&#xa;+ academicYear: String&#xa;+ subjects: [{ code, name, credits, internalMarks,&#xa;   externalMarks, totalMarks, maxMarks,&#xa;   grade, gradePoints, backlog, remarks }]&#xa;+ sgpa: Number (0.00 - 10.00)&#xa;+ totalMarks: Number | maxMarks: Number&#xa;+ percentage: Number | credits: Number&#xa;+ status: Enum [DRAFT, SUBMITTED, VERIFIED]&#xa;+ lastModifiedBy: ObjectId [FK -> User._id]&#xa;+ lastModifiedRole: String&#xa;+ auditHistory: [{ modifiedBy, role, action, reason,&#xa;   previousValues, newValues, timestamp }]" style="text;strokeColor=none;fillColor=#FFFBEB;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;fontColor=#1E293B;" vertex="1" parent="ent-academic">
          <mxGeometry y="30" width="350" height="270" as="geometry" />
        </mxCell>

        <!-- ==================== ENTITY 4: DOCUMENT ==================== -->
        <mxCell id="ent-doc" value="Document (documents)&#xa;«Secure Student Document Vault»" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#7C3AED;strokeColor=#6D28D9;fontColor=#FFFFFF;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1170" y="120" width="330" height="340" as="geometry" />
        </mxCell>
        <mxCell id="doc-f1" value="+ _id: ObjectId [PK]&#xa;+ student: ObjectId [FK -> User._id]&#xa;+ uploadedBy: ObjectId [FK -> User._id]&#xa;+ originalFilename: String&#xa;+ displayName: String&#xa;+ documentType: Enum [Marks card, Certificate,&#xa;   Internship, Resume, ID Document, Project, Other]&#xa;+ description: String&#xa;+ mimeType: String | fileSize: Number&#xa;+ storageProvider: Enum [cloudinary, local]&#xa;+ storageId: String&#xa;+ secureUrl: String (Cloud / Disk Proxy)&#xa;+ documentRequest: ObjectId [FK -> DocumentRequest._id]&#xa;+ reviewStatus: Enum [PENDING_REVIEW, APPROVED, REJECTED]&#xa;+ reviewedBy: ObjectId [FK -> User._id]&#xa;+ reviewedAt: Date&#xa;+ reviewComment: String&#xa;+ rejectionReason: String&#xa;+ reviewHistory: [{ reviewer, status, comment, date }]" style="text;strokeColor=none;fillColor=#FAF5FF;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;fontColor=#1E293B;" vertex="1" parent="ent-doc">
          <mxGeometry y="30" width="330" height="310" as="geometry" />
        </mxCell>

        <!-- ==================== ENTITY 5: DOCUMENT REQUEST ==================== -->
        <mxCell id="ent-docreq" value="DocumentRequest (documentrequests)&#xa;«Mentor-Initiated Document Tasks»" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#9333EA;strokeColor=#7E22CE;fontColor=#FFFFFF;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1170" y="500" width="330" height="260" as="geometry" />
        </mxCell>
        <mxCell id="dreq-f1" value="+ _id: ObjectId [PK]&#xa;+ student: ObjectId [FK -> User._id]&#xa;+ mentor: ObjectId [FK -> User._id]&#xa;+ title: String&#xa;+ documentType: String&#xa;+ description: String&#xa;+ priority: Enum [LOW, MEDIUM, HIGH, URGENT]&#xa;+ dueDate: Date&#xa;+ isRequired: Boolean&#xa;+ status: Enum [PENDING, UPLOADED, UNDER REVIEW,&#xa;   APPROVED, REJECTED]&#xa;+ submittedDocument: ObjectId [FK -> Document._id]&#xa;+ reviewHistory: [{ reviewer, action, reason, date }]&#xa;+ [VIRTUAL] isOverdue: Boolean" style="text;strokeColor=none;fillColor=#FAF5FF;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;fontColor=#1E293B;" vertex="1" parent="ent-docreq">
          <mxGeometry y="30" width="330" height="230" as="geometry" />
        </mxCell>

        <!-- ==================== ENTITY 6: MENTORING MEETING ==================== -->
        <mxCell id="ent-meeting" value="MentoringMeeting (mentoringmeetings)&#xa;«Advising Sessions &amp; Minutes»" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="440" width="340" height="340" as="geometry" />
        </mxCell>
        <mxCell id="meet-f1" value="+ _id: ObjectId [PK]&#xa;+ student: ObjectId [FK -> User._id]&#xa;+ mentor: ObjectId [FK -> User._id]&#xa;+ title: String&#xa;+ purpose: String&#xa;+ agenda: String | description: String&#xa;+ date: String | startTime: String | endTime: String&#xa;+ duration: Number (Minutes)&#xa;+ type: Enum [IN_PERSON, VIRTUAL, ONLINE]&#xa;+ venue: String | meetingUrl: String&#xa;+ preparationInstructions: String&#xa;+ status: Enum [SCHEDULED, CONFIRMED, COMPLETED,&#xa;   CANCELLED, RESCHEDULED]&#xa;+ discussionPoints: String (Minutes of Meeting)&#xa;+ studentConcerns: String&#xa;+ mentorObservations: String&#xa;+ actionItems: String&#xa;+ followUpDate: String" style="text;strokeColor=none;fillColor=#EFF6FF;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;fontColor=#1E293B;" vertex="1" parent="ent-meeting">
          <mxGeometry y="30" width="340" height="310" as="geometry" />
        </mxCell>

        <!-- ==================== ENTITY 7: MENTOR NOTE & TASK ==================== -->
        <mxCell id="ent-note" value="MentorNote &amp; MentoringTask&#xa;«Counseling Observations &amp; Action Items»" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#475569;strokeColor=#334155;fontColor=#FFFFFF;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="820" width="340" height="230" as="geometry" />
        </mxCell>
        <mxCell id="note-f1" value="MentorNote:&#xa;+ student: ObjectId [FK -> User._id]&#xa;+ mentor: ObjectId [FK -> User._id]&#xa;+ title: String | discussion: String | actionRequired: String&#xa;+ date: String | tag: String&#xa;&#xa;MentoringTask:&#xa;+ student: ObjectId [FK -> User._id]&#xa;+ assignedBy: ObjectId [FK -> User._id]&#xa;+ title: String | description: String&#xa;+ priority: Enum [LOW, MEDIUM, HIGH, URGENT]&#xa;+ dueDate: String | status: Enum [PENDING, IN_PROGRESS, COMPLETED]&#xa;+ progress: Number (0-100%)" style="text;strokeColor=none;fillColor=#F8FAFC;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;fontColor=#1E293B;" vertex="1" parent="ent-note">
          <mxGeometry y="30" width="340" height="200" as="geometry" />
        </mxCell>

        <!-- ==================== ENTITY 8: PORTFOLIO ENTITIES ==================== -->
        <mxCell id="ent-portfolio" value="Co-Curricular Portfolio Entities&#xa;«Projects, Certifications, Internships»" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#0284C7;strokeColor=#0369A1;fontColor=#FFFFFF;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="910" width="350" height="240" as="geometry" />
        </mxCell>
        <mxCell id="port-f1" value="Project:&#xa;+ student: ObjectId [FK -> User._id]&#xa;+ title: String | description: String | techStack: String[]&#xa;+ githubUrl: String | liveUrl: String | role: String&#xa;&#xa;Certification:&#xa;+ student: ObjectId [FK -> User._id]&#xa;+ name: String | issuer: String | issueDate: String&#xa;+ credentialId: String | verificationUrl: String&#xa;&#xa;Internship:&#xa;+ student: ObjectId [FK -> User._id]&#xa;+ company: String | role: String | duration: String" style="text;strokeColor=none;fillColor=#F0F9FF;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;fontColor=#1E293B;" vertex="1" parent="ent-portfolio">
          <mxGeometry y="30" width="350" height="210" as="geometry" />
        </mxCell>

        <!-- ==================== ENTITY 9: DEPARTMENT & SYSTEM ==================== -->
        <mxCell id="ent-dept" value="Institutional Governance Entities&#xa;«Department &amp; System Notifications»" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#0F766E;strokeColor=#115E59;fontColor=#FFFFFF;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1170" y="790" width="330" height="220" as="geometry" />
        </mxCell>
        <mxCell id="dept-f1" value="Department:&#xa;+ _id: ObjectId [PK]&#xa;+ name: String&#xa;+ code: String [UNIQUE] (e.g. 'CSE', 'ECE')&#xa;+ hod: ObjectId [FK -> User._id]&#xa;&#xa;Notification:&#xa;+ _id: ObjectId [PK]&#xa;+ recipient: ObjectId [FK -> User._id]&#xa;+ title: String | message: String&#xa;+ type: String | read: Boolean&#xa;+ createdAt: Date" style="text;strokeColor=none;fillColor=#F0FDFA;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;fontColor=#1E293B;" vertex="1" parent="ent-dept">
          <mxGeometry y="30" width="330" height="190" as="geometry" />
        </mxCell>

        <!-- ==================== RELATIONSHIPS & CONNECTORS ==================== -->
        <!-- User to StudentProfile (1 : 1) -->
        <mxCell id="rel-user-profile" value="1 : 1 (User owns StudentProfile)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.25;entryDx=0;entryDy=0;exitX=0;exitY=0.25;exitDx=0;exitDy=0;strokeColor=#059669;strokeWidth=2;fontColor=#047857;fontSize=11;" edge="1" parent="1" source="ent-user" target="ent-profile">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- User to StudentProfile as Mentor (1 : N) -->
        <mxCell id="rel-mentor-profile" value="1 : N (Mentor assigned to Mentees)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;exitX=0;exitY=0.75;exitDx=0;exitDy=0;strokeColor=#059669;strokeWidth=2;fontColor=#047857;fontSize=11;" edge="1" parent="1" source="ent-user" target="ent-profile">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- User to AcademicRecord (1 : N) -->
        <mxCell id="rel-user-academic" value="1 : N (Student Semester Marks)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.25;entryDx=0;entryDy=0;exitX=0.25;exitY=1;exitDx=0;exitDy=0;strokeColor=#D97706;strokeWidth=2;fontColor=#B45309;fontSize=11;" edge="1" parent="1" source="ent-user" target="ent-academic">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- User to Document (1 : N) -->
        <mxCell id="rel-user-doc" value="1 : N (Uploaded / Owned Documents)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.35;entryDx=0;entryDy=0;exitX=1;exitY=0.35;exitDx=0;exitDy=0;strokeColor=#7C3AED;strokeWidth=2;fontColor=#6D28D9;fontSize=11;" edge="1" parent="1" source="ent-user" target="ent-doc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- User to MentoringMeeting (1 : N) -->
        <mxCell id="rel-user-meeting" value="1 : N (Student / Mentor in Meeting)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeColor=#2563EB;strokeWidth=2;fontColor=#1D4ED8;fontSize=11;" edge="1" parent="1" source="ent-user" target="ent-meeting">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DocumentRequest to Document (1 : 1 Fulfillment) -->
        <mxCell id="rel-req-doc" value="1 : 1 (Fulfillment Document Link)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;strokeColor=#9333EA;strokeWidth=2;fontColor=#7E22CE;fontSize=11;" edge="1" parent="1" source="ent-docreq" target="ent-doc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- User to Department (1 : 1 HOD Reference) -->
        <mxCell id="rel-user-dept" value="1 : 1 (Assigned HOD of Dept)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.8;exitDx=0;exitDy=0;strokeColor=#0F766E;strokeWidth=2;fontColor=#115E59;fontSize=11;" edge="1" parent="1" source="ent-user" target="ent-dept">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
